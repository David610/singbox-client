<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
          Merged into the host app's manifest by the Android Gradle Plugin
          manifest merger. android:permission="android.permission.BIND_VPN_SERVICE"
          is what makes this a system-recognized VpnService component; the
          intent-filter is what lets the OS "Always-on VPN" / "VPN apps"
          settings screen discover it.
        -->
        <service
            android:name="app.singboxclient.vpn_core.SingBoxVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
