<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build-only. Permits plaintext HTTP only to loopback and the
  Android emulator's host-loopback alias, for local Flutter tooling and a
  locally-hosted dev server reachable from an emulator. (Android's
  network-security-config <domain> entries are exact hostnames/IP
  literals, not CIDR ranges, so this intentionally does not open up
  arbitrary LAN addresses.) All other destinations, and every
  release/profile build regardless of destination, still require HTTPS
  (base-config below has cleartextTrafficPermitted="false").
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
